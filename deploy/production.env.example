# Copy to .env on the production server. Never commit the filled file.
# Fresh installation only: when migrating a database, preserve KEY_ENCRYPTION_SECRET.
NODE_ENV=production
APP_NAME=ProxyKey
PUBLIC_APP_URL=https://replace-with-your-domain.example
ADDITIONAL_BROWSER_ORIGINS=
# Place a configured HTTPS reverse proxy on the same host in front of this port.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
TRUST_PROXY=true
LOG_LEVEL=info

POSTGRES_DB=proxiapp
POSTGRES_USER=proxiapp
POSTGRES_PASSWORD=
# Must use the same password as POSTGRES_PASSWORD; URL-encode special characters.
DATABASE_URL=
SESSION_SECRET=
KEY_ENCRYPTION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

PRICE_MARKUP=2
BILLING_USDT_PER_USD=1
USERS_PER_UPSTREAM_KEY=2
DEFAULT_CURRENCY=USDT
PAYMENT_METHODS=nowpayments
PAYMENT_CURRENCIES=USDT
ALLOW_MOCK_PAYMENTS=false
# Enable only after live payment + provider checks and backup restore verification.
SALES_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=usdtton
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

DEFAULT_UPSTREAM_NAME=Codex Everywhere
DEFAULT_UPSTREAM_SLUG=codex-everywhere
UPSTREAM_BASE_URL=https://codex-everywhere.com
CE_AUTO_PROVISION_KEYS=false
CE_KEY_SYNC_ENABLED=true
CE_BALANCE_MONITOR_ENABLED=true
PROVIDER_BALANCE_LOW_USD=20
# Management login/password belong only in .env.ce, loaded by worker.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_ALERT_EMAIL=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
