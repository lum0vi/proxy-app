{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat", "title": "API up", "id": 1, "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"proxiapp\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Active AI requests", "id": 2, "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(proxiapp_proxy_active_requests)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 25 }, { "color": "red", "value": 75 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "PostgreSQL", "id": 3, "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "pg_up", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Wholesale cost", "id": 4, "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(proxiapp_wholesale_usage_cost_total)", "legendFormat": "USD", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Orders awaiting payment or delivery", "id": 5, "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "proxiapp_pending_orders", "legendFormat": "{{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 50 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "timeseries", "title": "Proxy throughput", "id": 6, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (provider) (rate(proxiapp_proxy_requests_total[5m]))", "legendFormat": "{{provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Upstream latency", "id": 7, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(proxiapp_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(proxiapp_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(proxiapp_proxy_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Errors by provider", "id": 8, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum by (provider, status) (rate(proxiapp_proxy_requests_total{status=~\"5..|UPSTREAM_.*\"}[5m]))", "legendFormat": "{{provider}} {{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Node saturation", "id": 9, "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        { "expr": "proxiapp_process_resident_memory_bytes", "legendFormat": "RSS", "refId": "A" },
        { "expr": "proxiapp_nodejs_heap_size_used_bytes", "legendFormat": "Heap", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Event loop lag", "id": 10, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [{ "expr": "proxiapp_nodejs_eventloop_lag_p99_seconds", "legendFormat": "p99", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.25 }] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } }
    },
    {
      "type": "bargauge", "title": "Provider capacity", "id": 11, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        { "expr": "proxiapp_upstream_customer_key_capacity{kind=\"total\"}", "legendFormat": "{{provider}} total", "refId": "A" },
        { "expr": "proxiapp_upstream_customer_key_capacity{kind=\"assigned\"}", "legendFormat": "{{provider}} assigned", "refId": "B" },
        { "expr": "proxiapp_upstream_customer_key_capacity{kind=\"reserved\"}", "legendFormat": "{{provider}} reserved", "refId": "C" },
        { "expr": "proxiapp_upstream_customer_key_capacity{kind=\"sellable\"}", "legendFormat": "{{provider}} sellable", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0, "color": { "mode": "palette-classic" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" }
    },
    {
      "type": "timeseries", "title": "Upstream time to first byte (p95)", "id": 12, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (provider, le) (rate(proxiapp_upstream_first_body_byte_seconds_bucket[5m])))", "legendFormat": "{{provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Usage to reconcile (15 min)", "id": 13, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [{ "expr": "sum by (provider, kind) (increase(proxiapp_proxy_accounting_anomalies_total[15m]))", "legendFormat": "{{provider}} {{kind}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Provider account balance (USD)", "id": 14, "gridPos": { "h": 8, "w": 16, "x": 0, "y": 36 },
      "targets": [
        { "expr": "proxiapp_provider_account_balance_usd", "legendFormat": "{{provider}} balance", "refId": "A" },
        { "expr": "proxiapp_provider_account_low_balance_threshold_usd", "legendFormat": "{{provider}} alert threshold", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Provider balance monitoring", "id": 15, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "targets": [{ "expr": "proxiapp_provider_account_balance_check_healthy", "legendFormat": "{{provider}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "UNKNOWN / STALE", "color": "red" }, "1": { "text": "CURRENT", "color": "green" } } }], "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 40,
  "tags": ["proxiapp", "gateway"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ProxyKey / Service Overview",
  "uid": "proxiapp-overview",
  "version": 1
}
