# Runtime
NODE_ENV=development
APP_NAME=ProxyKey
PUBLIC_APP_URL=http://localhost:8080
# Optional additional browser addresses, comma-separated; exact origins, no wildcards.
# Example for LAN access: keep PUBLIC_APP_URL at your LAN URL and add localhost here.
ADDITIONAL_BROWSER_ORIGINS=
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true

# PostgreSQL (Compose defaults match these values)
POSTGRES_DB=proxiapp
POSTGRES_USER=proxiapp
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgres://proxiapp:change-me-in-production@postgres:5432/proxiapp
POSTGRES_HOST_PORT=55432

# Bootstrap admin (used only when no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Security: generate independent values with `openssl rand -hex 32`
SESSION_SECRET=replace-with-at-least-32-random-characters
KEY_ENCRYPTION_SECRET=replace-with-64-hex-characters
SESSION_TTL_DAYS=30
API_KEY_PREFIX=pk_live_

# Commercial model. Any positive decimal value is accepted (for example 1.75).
PRICE_MARKUP=2
# Customer balances and rates use USDT. Convert native wholesale USD into USDT when pricing new keys.
BILLING_USDT_PER_USD=1
# RUB quotes: live USDT/RUB from CoinGecko, or an explicit fixed merchant rate below.
PRICE_RATES_URL=https://api.coingecko.com/api/v3/simple/price?ids=tether&vs_currencies=usd,rub&include_last_updated_at=true
PRICE_RATES_API_KEY=
USDT_RUB_RATE=
# Maximum active/reserved customer keys assigned to one CE upstream credential.
USERS_PER_UPSTREAM_KEY=2
DEFAULT_CURRENCY=USDT

# Codex Everywhere / other OpenAI-compatible upstream
DEFAULT_UPSTREAM_NAME=Codex Everywhere
DEFAULT_UPSTREAM_SLUG=codex-everywhere
UPSTREAM_BASE_URL=https://codex-everywhere.com
# false: add CE keys manually. true: the worker maintains free slots in each configured pool.
CE_AUTO_PROVISION_KEYS=false
# Format: pool-slug:CE-group-id,pool-slug:CE-group-id. Put CE_PROVISION_EMAIL and CE_PROVISION_PASSWORD in .env.ce.
CE_PROVISION_GROUPS=
CE_PROVISION_FREE_SLOTS=2
# Auto provisioning always enables balance monitoring. Set true to monitor in manual mode too.
CE_BALANCE_MONITOR_ENABLED=false
# Read CE key status/quota and match keys to ProxyKey credentials without storing extra secrets.
# Auto provisioning also enables this sync. Requires account access in the worker's .env.ce.
CE_KEY_SYNC_ENABLED=false
CE_KEY_SYNC_INTERVAL_MS=300000
# Uses the same worker-only credentials from .env.ce. Amounts refer to the provider account, in USD.
PROVIDER_BALANCE_LOW_USD=20
PROVIDER_BALANCE_CHECK_INTERVAL_MS=300000
PROVIDER_BALANCE_ALERT_REPEAT_HOURS=24
UPSTREAM_REQUEST_TIMEOUT_MS=900000
UPSTREAM_HEALTH_INTERVAL_MS=300000
FORCE_STREAM_USAGE=true
AFFINITY_TTL_HOURS=24
PROXY_ALLOWED_PATHS=/v1/models,/v1/responses,/v1/responses/compact,/v1/chat/completions,/v1/images/generations,/v1/messages,/v1beta/models,/v1beta/generateContent,/v1beta/streamGenerateContent
# Largest explicit output limit; assumed for reservation if omitted. Not injected upstream.
PROXY_ASSUMED_MAX_OUTPUT_TOKENS=128000
PROXY_UNCONFIRMED_COOLDOWN_MS=60000

# First production launch: USDT on TON via NOWPayments. Use mock only locally.
# SALES_ENABLED=true
# Defaults to false in production, true locally.
PAYMENT_METHODS=mock
PAYMENT_CURRENCIES=USDT
# To test RUB later, explicitly add RUB to PAYMENT_CURRENCIES.
# mock never charges real money. Keep yookassa disabled for the crypto-only launch.
ALLOW_MOCK_PAYMENTS=true
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=usdtton
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# USDT token on TON, not native Toncoin. Configure a USDT payout wallet with NOWPayments.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
# Must be false with live credentials in production. Cards and SBP are enabled in the shop account.
YOOKASSA_TEST_MODE=true
# Set receipt parameters to match the shop's fiscal configuration.
YOOKASSA_RECEIPTS_ENABLED=false
YOOKASSA_VAT_CODE=1
# Optional, only when required by the shop's receipt integration:
# YOOKASSA_TAX_SYSTEM_CODE=1
# Retain these only if reconciling old Stripe orders. New Stripe checkout is disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email notifications (optional; logged instead when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ProxyKey <noreply@example.com>
ADMIN_ALERT_EMAIL=admin@example.com
KEY_EXPIRY_NOTICE_DAYS=7,3,1
KEY_BALANCE_NOTICE_PERCENT=20,10,5

# Local ingress and observability
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
